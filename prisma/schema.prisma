generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id
  name      String
  category  String
  price     Float
  unit      String
  weight    String?
  imageUrl  String?
  stock         Float    @default(100)
  packagedByUs  Boolean  @default(false)
  nutritionInfo  String?
  specifications String?
  kgStep         Float    @default(1)
  salePrice       Float?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Customer {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  isBusiness   Boolean  @default(false)
  company      String   @default("")
  cui          String   @default("")
  phone        String   @default("")
  county       String   @default("")
  city         String   @default("")
  address           String   @default("")
  emailVerified     Boolean  @default(false)
  verificationToken String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Order {
  id        String      @id
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    String      @default("Noua")
  company   String
  cui       String      @default("")
  contact   String
  phone     String
  email     String
  county    String
  city      String      @default("")
  address   String      @default("")
  notes     String      @default("")
  total     Float
  weight    Float
  items     OrderItem[]
}

model Conversation {
  id           String        @id @default(cuid())
  ip           String
  sessionToken String        @default("")
  status       String        @default("open")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]

  @@index([ip])
  @@index([sessionToken])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AdminOtp {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  text           String
  sender         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  category  String
  price     Float
  unit      String
  weight    String?
  qty       Float
  actualQty Float?
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SiteSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  source    String
  page      String   @default("/")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model AbandonedCart {
  id        String   @id @default(cuid())
  items     Json
  total     Float
  email     String?
  phone     String?
  contact   String?
  county    String?
  city      String?
  converted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([converted])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  role      String
  email     String?
  code      String
  verified  Boolean  @default(false)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
